# LLM Provider Configuration (choose one or use LANGCHAIN_MODEL)
# Provider-agnostic: set LANGCHAIN_MODEL to any supported model
# Examples: openai/gpt-4o, anthropic/claude-3-5-sonnet, google/gemini-1.5-pro
LANGCHAIN_MODEL=openai/gpt-4o-mini

# OpenAI (if using OpenAI models)
# OPENAI_API_KEY=your-openai-key-here

# Anthropic (if using Anthropic models)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Google (if using Google models)
# GOOGLE_API_KEY=your-google-key-here

# Optional: LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key
# LANGCHAIN_PROJECT=langchain-examples